{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["mcp-ai-memory"],
      "enabled": true,
      "environment": {
        "DATABASE_URL": "postgresql://aimemory:change_me@localhost:5432/aimemory",
        "EMBEDDING_MODEL": "Xenova/all-MiniLM-L6-v2",
        "LOG_LEVEL": "info"
      }
    }
  },

  "default_agent": "doc_architect",

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },

  "watcher": {
    "ignore": ["node_modules/**", ".git/**", "dist/**", "*.svg", "*.png"]
  },

  "instructions": [
    "AGENTS.md"
  ]
}
